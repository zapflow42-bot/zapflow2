{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install -r"
  },
  "deploy": {
    "startCommand": "npm install -g tsx pm2 && pm2-runtime start ecosystem.config.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60
  }
}
