# ── Firebase ───────────────────────────────────────────
FIREBASE_PROJECT_ID=zapflow-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@zapflow-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Redis (Upstash — copiar URL do painel) ─────────────
REDIS_URL=rediss://default:senha@region.upstash.io:6379

# ── Brevo (Email) ──────────────────────────────────────
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=noreply@seudominio.com.br
BREVO_SENDER_NAME=ZapFlow

# ── Telegram (grammy) ──────────────────────────────────
# Criar bot: abrir @BotFather no Telegram → /newbot → copiar token
TELEGRAM_BOT_TOKEN=1234567890:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_WEBHOOK_URL=   # deixar vazio em dev (usa long polling)

# ── Claude AI ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Módulos (em produção pode ser IPs diferentes) ──────
MODULE_WHATSAPP_URL=http://localhost:4001
MODULE_EMAIL_URL=http://localhost:4002
MODULE_TELEGRAM_URL=http://localhost:4003
MODULE_AI_URL=http://localhost:4004

# ── Servidor ───────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
